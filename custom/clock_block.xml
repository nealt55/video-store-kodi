            <!-- VIDEO STORE NEON CLOCK -->
            <!-- Single replacement for the stock Arctic Zephyr clock/date. -->
            <control type="group">
                <left>0</left>
                <right>0</right>
                <top>0</top>
                <height>104</height>
                <control type="image">
                    <top>0</top>
                    <right>24</right>
                    <width>520</width>
                    <height>104</height>
                    <texture background="true">media/neon-clock-panel.png</texture>
                    <aspectratio>stretch</aspectratio>
                </control>
                <control type="label">
                    <top>9</top>
                    <right>166</right>
                    <width>300</width>
                    <height>46</height>
                    <align>right</align>
                    <aligny>center</aligny>
                    <font>LargeBold</font>
                    <textcolor>FFFF4DB8</textcolor>
                    <label>$INFO[System.Time(hh:mm)]</label>
                </control>
                <control type="label">
                    <top>12</top>
                    <right>52</right>
                    <width>96</width>
                    <height>36</height>
                    <align>left</align>
                    <aligny>center</aligny>
                    <font>SmallBold</font>
                    <textcolor>FF35BFFF</textcolor>
                    <label>$INFO[System.Time(xx)]</label>
                    <visible>!String.IsEmpty(System.Time(xx))</visible>
                </control>
                <control type="label">
                    <top>67</top>
                    <right>48</right>
                    <width>424</width>
                    <height>25</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>Tiny</font>
                    <textcolor>FFFF4DB8</textcolor>
                    <label>$INFO[System.Date]</label>
                </control>
            </control>
